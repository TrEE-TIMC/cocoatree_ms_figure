from utils.colors_and_labels import sectors_cm, labels


def plot_pymol_sectors(dataset, metric, correction, path_to_script):


	residue_swap = pd.read_csv(
		os.path.join(
			path_to_script,
		f"results/cocoatree_gt/{dataset}/cocoatree_{metric}_{correction}.csv"))
	residue_swap = residue_swap.loc[~residue_swap["pdb_pos"].isna()]

	columns = [c for c in residue_swap.columns if c.startswith("sector_")]
	columns.sort()

	residue_lists = [
		residue_swap.loc[residue_swap[c], "pdb_named_pos"].to_numpy()
		for c in columns]
	residue_weights = [
		residue_swap.loc[residue_swap[col], f"IC{col.split('_')[-1]}"].to_numpy()
		for col in columns]


	sectors_to_plot = np.arange(len(columns))

	# Start by 'cleaning' the structure
	def clean_residues():
		for residue in residue_swap["pdb_named_pos"].values:
			cmd.color("gray80", f"resi {residue}")
			cmd.hide("spheres", f"resi {residue}")

	for sector in sectors_to_plot:
		clean_residues()

	
		for s, residue_pos in enumerate(residue_lists):

			if s != sector:
				continue

			# Normalize residue weights
			weights = residue_weights[s]
			if len(weights):
				weights -= weights.min()
				weights /= weights.max()

			colors = sectors_cm[f"sector_{s+1}"](weights)

			for i in range(len(residue_pos)):
				r, g, b, _ = colors[i]
				residue = residue_pos[i]

				color_name = f"residue_{s}_{residue}"
				cmd.set_color(color_name, [r, g, b])
				cmd.color(color_name, f"resi {residue}")
				cmd.show("spheres", f"resi {residue}")

		cmd.ray(10000, 10000)
		outname = os.path.join(
			path_to_script,
			f"images/cocoatree_gt/{dataset}/cocoatree_{metric}_{correction}_")
		os.makedirs(os.path.dirname(outname), exist_ok=True)

		sector_name = labels[sector] 
		cmd.png(outname + f"{sector_name}_sector_1.png", dpi=300)


		cmd.rotate("x", 180)
		cmd.ray(10000, 10000)
		cmd.png(outname + f"{sector_name}_sector_2.png", dpi=300)


for metric, correction in itertools.product(metrics, corrections):
    plot_pymol_sectors(dataset, metric, correction, path_to_script)

